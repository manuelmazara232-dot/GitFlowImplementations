<Window x:Class="GitFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitFlow.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DockPanel x:Name="ControlDock" LastChildFill="False" Margin="0,0,0,387">
            <ToolBarTray x:Name="TBTray" HorizontalAlignment="Center" Height="auto" VerticalAlignment="Top" Width="800">
                <ToolBar HorizontalAlignment="Center" Height="auto" VerticalAlignment="Center" Width="800">

                    <TextBox TextWrapping="Wrap" Text="TextBox" Width="258" VerticalAlignment="Top" Height="29"/>
                    <Button x:Name="CreateBtn" Content="Button" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="DeleteBtn" Content="Button" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="EditBtn" Content="Button" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top"/>

                </ToolBar>
            </ToolBarTray>
        </DockPanel>
        <DataGrid x:Name="MainCrudDataGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,74,0,-74" SelectionChanged="MainCrudDataGrid_SelectionChanged" Loaded="MainCrudDataGrid_Loaded"/>


    </Grid>
</Window>
